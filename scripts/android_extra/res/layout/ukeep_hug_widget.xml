<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ukeep_widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/h_send"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤗"
            android:textSize="38sp" />
        <TextView
            android:id="@+id/h_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ti penso"
            android:textColor="#2A2430"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="2" />
        <TextView
            android:id="@+id/h_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8C8294"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/h_recv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💛"
            android:textSize="34sp" />
        <TextView
            android:id="@+id/h_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2A2430"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="2" />
        <TextView
            android:id="@+id/h_rtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8C8294"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/h_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ukeep_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="❤️ Anch\'io"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/h_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="✕"
                android:textColor="#8C8294"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
