<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/ukeep_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Ukeep" />

        <TextView
            android:id="@+id/w_together"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Ukeep"
            android:textColor="#2A2430"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Apri Ukeep per aggiornare"
        android:textColor="#B9743C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:textColor="#2A2430"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8C8294"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
