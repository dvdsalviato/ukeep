rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // codice invito -> coupleId (si può solo leggere conoscendo il codice)
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn();
    }

    match /couples/{coupleId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && request.resource.data.members.size() <= 2 && (
        request.auth.uid in resource.data.members ||
        (resource.data.members.size() == 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
      );

      // attività, liste, eventi, progetti, desideri...
      match /{document=**} {
        allow read, write: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
      }
    }
  }
}
